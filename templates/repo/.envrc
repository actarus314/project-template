# Dev only — never versioned. Two roles, not to be confused:
#   1) load the APPLICATION variables from .env (ALCHEMY_API_KEY, etc.) — the PAT is NEVER in .env;
#   2) expose to git/gh the PAT of THIS repo, defined right here (GITHUB_PAT line below) and nowhere else.
set -a; [ -f .env ] && . ./.env; set +a     # replaces direnv's `dotenv` builtin, which would make this file NON-sourceable in a non-interactive shell
export GITHUB_PAT=                            # fine-grained PAT restricted to THIS repo — to fill in (see workspace/secrets.md)
export GH_TOKEN="$GITHUB_PAT"

# PAT expiry warning (standard §5). A dead PAT breaks push/PR mid-session: warn BEFORE.
# GitHub returns the end date in the `GitHub-Authentication-Token-Expiration` header.
# Daily cache in .git/ (never committed) — 1 network call/day, no cron, no daemon.
# Silent if the PAT is absent, has no expiry, is offline, or is still valid beyond the threshold.
_pat_expiry_warn() {
  [ -n "$GITHUB_PAT" ] && [ -d .git ] || return 0
  local threshold=14 stamp=.git/.pat-expiry-checked today exp exp_epoch left
  today=$(date -u +%F)
  [ "$(cat "$stamp" 2>/dev/null)" = "$today" ] && return 0     # already checked today
  exp=$(curl -sfI -m 5 -H "Authorization: Bearer $GITHUB_PAT" https://api.github.com/user 2>/dev/null \
        | awk -F': ' 'tolower($1) == "github-authentication-token-expiration" { print $2 }' | tr -d '\r')
  printf '%s\n' "$today" > "$stamp" 2>/dev/null
  [ -n "$exp" ] || return 0                                     # no expiry, or offline → nothing to report
  exp_epoch=$(date -j -f '%Y-%m-%d' "${exp%% *}" +%s 2>/dev/null) || return 0
  left=$(( (exp_epoch - $(date +%s)) / 86400 ))
  [ "$left" -le "$threshold" ] || return 0
  if [ "$left" -lt 0 ]; then
    printf '\n  /!\\  GITHUB_PAT EXPIRED on %s — push/PR will fail.\n' "${exp%% *}" >&2
  else
    printf '\n  /!\\  GITHUB_PAT expires in %s day(s), on %s.\n' "$left" "${exp%% *}" >&2
  fi
  printf '      Regenerate (90 days, same permissions): https://github.com/settings/personal-access-tokens\n' >&2
  printf '      Then: replace the PAT in this .envrc + the date in ../workspace/secrets.md\n\n' >&2
}
_pat_expiry_warn
