# Dev uniquement — jamais versionné. Deux rôles, à ne pas confondre :
#   1) charger les variables APPLICATIVES de .env (ALCHEMY_API_KEY, etc.) — le PAT n'est JAMAIS dans .env ;
#   2) exposer à git/gh le PAT de CE repo, défini ici même (ligne GITHUB_PAT ci-dessous) et nulle part ailleurs.
set -a; [ -f .env ] && . ./.env; set +a     # remplace le builtin direnv `dotenv`, qui rendrait ce fichier NON sourçable en shell non-interactif
export GITHUB_PAT=                            # PAT fine-grained restreint à CE repo — à remplir (voir workspace/secrets.md)
export GH_TOKEN="$GITHUB_PAT"

# Alerte d'expiration du PAT (standard §5). Un PAT mort casse push/PR en pleine session : on prévient AVANT.
# GitHub renvoie la date de fin dans le header `GitHub-Authentication-Token-Expiration`.
# ponytail: cache journalier dans .git/ (jamais commité) — 1 appel réseau/jour, ni cron ni daemon.
# Silencieux si le PAT est absent, sans expiration, hors ligne, ou encore valide au-delà du seuil.
_pat_expiry_warn() {
  [ -n "$GITHUB_PAT" ] && [ -d .git ] || return 0
  local seuil=14 stamp=.git/.pat-expiry-checked today exp exp_epoch reste
  today=$(date -u +%F)
  [ "$(cat "$stamp" 2>/dev/null)" = "$today" ] && return 0     # déjà vérifié aujourd'hui
  exp=$(curl -sfI -m 5 -H "Authorization: Bearer $GITHUB_PAT" https://api.github.com/user 2>/dev/null \
        | awk -F': ' 'tolower($1) == "github-authentication-token-expiration" { print $2 }' | tr -d '\r')
  printf '%s\n' "$today" > "$stamp" 2>/dev/null
  [ -n "$exp" ] || return 0                                     # pas d'expiration, ou hors ligne → rien à signaler
  exp_epoch=$(date -j -f '%Y-%m-%d' "${exp%% *}" +%s 2>/dev/null) || return 0
  reste=$(( (exp_epoch - $(date +%s)) / 86400 ))
  [ "$reste" -le "$seuil" ] || return 0
  if [ "$reste" -lt 0 ]; then
    printf '\n  /!\\  GITHUB_PAT EXPIRE depuis le %s — push/PR vont echouer.\n' "${exp%% *}" >&2
  else
    printf '\n  /!\\  GITHUB_PAT expire dans %s jour(s), le %s.\n' "$reste" "${exp%% *}" >&2
  fi
  printf '      Regenerer (90 j, memes permissions) : https://github.com/settings/personal-access-tokens\n' >&2
  printf '      Puis : remplacer le PAT de ce .envrc + la date dans ../workspace/secrets.md\n\n' >&2
}
_pat_expiry_warn
